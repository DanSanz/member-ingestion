<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every test project: xUnit, the test support project and the shared fixture files. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <Using Include="MemberIngestion.TestSupport" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)MemberIngestion.TestSupport\MemberIngestion.TestSupport.csproj" />
    <None Include="$(MSBuildThisFileDirectory)fixtures\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
