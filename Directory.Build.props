<Project>
  <!--
    Build settings shared by every project in the repository.
    A change here changes every project at once: it needs a Technical Lead's review (CODEOWNERS).
    Fix a warning in the code; don't switch a warning off here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
